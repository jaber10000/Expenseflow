APP_NAME=ExpenseFlow API
ENVIRONMENT=development

# PostgreSQL (matches docker-compose.yml in the project root)
DATABASE_URL=postgresql+psycopg://expenseflow:expenseflow@localhost:5432/expenseflow

FRONTEND_ORIGIN=http://localhost:5173

# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with the default key when ENVIRONMENT=production.
SECRET_KEY=dev-only-change-me-dev-only-change-me-0000
ACCESS_TOKEN_MINUTES=60

# Cookie settings. In production over HTTPS set COOKIE_SECURE=true.
# Use COOKIE_SAMESITE=lax when frontend and API share a site (recommended, see README);
# use none only when they are on different sites (requires COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
